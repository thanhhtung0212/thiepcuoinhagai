{
  "name": "thiepmoi",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/wishes/api.php",
      "/api/rsvp"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thiepmoi-wishes",
      "database_id": "b5166595-d9ba-4438-98a3-b766c1122342"
    }
  ],
  "observability": {
    "enabled": true
  }
}
